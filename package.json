{
  "name": "prose-scrub",
  "version": "0.3.0",
  "description": "Scan prose for AI writing tells: dashes, stock phrases, pre-negation, flat rhythm. A gate for anything published under your name.",
  "type": "module",
  "private": true,
  "bin": {
    "prose-scrub": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile=dist/prose-scrub src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "parse5": "^8.0.1",
    "typescript": "^6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mackenziebowes/prose-scrub"
  },
  "author": "Mackenzie Bowes"
}
